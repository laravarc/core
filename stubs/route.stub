<?php

declare(strict_types=1);

use {{ controllerClass }};
use Illuminate\Support\Facades\Route;

{{ routeGroupOpen }}
    Route::controller({{ controllerShortName }}::class)->group(function (): void {
        Route::prefix('{{ resourceName }}')->group(function (): void {
            Route::get('', 'index')->name('{{ moduleKey }}.index');
            Route::post('', 'store')->name('{{ moduleKey }}.store');
            Route::get('{id}', 'show')->name('{{ moduleKey }}.show');
            Route::put('{id}', 'update')->name('{{ moduleKey }}.update');
            Route::delete('{id}', 'destroy')->name('{{ moduleKey }}.destroy');
        });
    });
{{ routeGroupClose }}
